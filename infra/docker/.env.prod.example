# === uagreen.co site — production env (copy to /opt/uagreen_site/infra/docker/.env on the VPS) ===

# PostgreSQL
POSTGRES_DB=uagreen_site
POSTGRES_USER=uagreen_site
POSTGRES_PASSWORD=changeme-generated

# JWT — ALL THREE MUST be byte-identical to Gospodar's (JWT_SIGNING_KEY / JWT_ISSUER /
# JWT_AUDIENCE). The site API validates Gospodar-minted tokens for the admin.
JWT_SIGNING_KEY=your-super-secret-key-at-least-32-chars
JWT_ISSUER=UaGreenApi
JWT_AUDIENCE=UaGreenApp

# Gospodar is the identity provider for the admin (auth proxy).
GOSPODAR_BASE_URL=https://erp.uagreen.co
# Site → Gospodar (X-Api-Key): contact-form/consultation leads (source «Сайт uagreen.co»), free audit
# days and paid site-audit bookings. Prod: the UA GREEN company key — until Gospodar ships per-integration
# keys it is the SAME one Oberig uses (re-issuing it breaks Oberig). Staging: the Gospodar test company's
# key, or empty to keep test requests out of the CRM (the audit calendar then shows its fallback).
# Contact requests go to the CRM automatically; site orders are switched on in the admin:
# Налаштування → Господар (CRM).
GOSPODAR_INTEGRATION_KEY=

# Site chat key: the same as SITECHAT__APIKEY in Gospodar; empty = chat disabled (keep it empty on staging).
# It MUST differ from GOSPODAR_INTEGRATION_KEY above and from Gospodar's INTEGRATION__APIKEY: the chat key
# only opens /api/site-chat/*, so a leak from the chat proxy cannot reach the CRM integration API.
SITE_CHAT_API_KEY=

# Public origins. Staging: https://new.uagreen.co / https://admin-new.uagreen.co
PUBLIC_BASE_URL=https://uagreen.co
ADMIN_BASE_URL=https://admin.uagreen.co

# SMTP — order / application / contact notifications.
SMTP_HOST=smtp.example.com
SMTP_USER=apikey-or-user
SMTP_PASSWORD=changeme
SMTP_FROM=site@uagreen.co
ORDER_EMAIL=sales@uagreen.co

# monobank. Empty = that payment method is hidden on the site.
# Card: internet-acquiring X-Token (web.monobank.ua → Еквайринг). A TEST token from api.monobank.ua treats any
# card as paid — never on prod: a "paid" test audit books a real trip in Gospodar.
MONOBANK_TOKEN=
# «Покупка частинами»: prod https://u2.monobank.com.ua with the store-id/secret monobank issues after testing;
# staging: https://u2-demo-ext.mono.st4g3.com + test_store_with_confirm / secret_98765432--123-123.
MONOPARTS_BASE_URL=https://u2.monobank.com.ua
MONOPARTS_STORE_ID=
MONOPARTS_SECRET=

# Cloudflare Turnstile captcha on the contact / vacancy / checkout forms.
# dash.cloudflare.com → Turnstile → Add widget (hostnames: uagreen.co, new.uagreen.co),
# mode "Managed". Set BOTH or neither (empty = captcha off). Cloudflare's always-pass
# test pair for staging: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# One-time Weblium import: set to /import, `docker compose up -d api`, then clear.
IMPORT_DIR=
