# === uagreen.co site — production env (copy to /opt/uagreen_site/infra/docker/.env on the VPS) ===

# PostgreSQL
POSTGRES_DB=uagreen_site
POSTGRES_USER=uagreen_site
POSTGRES_PASSWORD=changeme-generated

# JWT — ALL THREE MUST be byte-identical to Gospodar's (JWT_SIGNING_KEY / JWT_ISSUER /
# JWT_AUDIENCE). The site API validates Gospodar-minted tokens for the admin.
JWT_SIGNING_KEY=your-super-secret-key-at-least-32-chars
JWT_ISSUER=UaGreenApi
JWT_AUDIENCE=UaGreenApp

# Gospodar is the identity provider for the admin (auth proxy).
GOSPODAR_BASE_URL=https://erp.uagreen.co

# Public origins. Staging: https://new.uagreen.co / https://admin-new.uagreen.co
PUBLIC_BASE_URL=https://uagreen.co
ADMIN_BASE_URL=https://admin.uagreen.co

# SMTP — order / application / contact notifications.
SMTP_HOST=smtp.example.com
SMTP_USER=apikey-or-user
SMTP_PASSWORD=changeme
SMTP_FROM=site@uagreen.co
ORDER_EMAIL=sales@uagreen.co

# LiqPay checkout. Keep LIQPAY_SANDBOX=true until the real keys are in.
LIQPAY_PUBLIC_KEY=sandbox_i00000000000
LIQPAY_PRIVATE_KEY=sandbox_changeme
LIQPAY_SANDBOX=true

# MinIO (S3 storage driver points at the local minio container). The bucket
# name is also the public URL prefix: PUBLIC_BASE_URL/media/<key>.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
S3_BUCKET=media
S3_REGION=us-east-1

# One-time Weblium import: set to /import, `docker compose up -d api`, then clear.
IMPORT_DIR=
